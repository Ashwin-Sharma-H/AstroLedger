# =============================================================================
# AstroLedger Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================================

# --- Django Core ---
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-get-random-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Option A: Full DATABASE_URL (takes highest priority)
# DATABASE_URL=postgres://astroledger_user:your_password@localhost:5432/astroledger

# Option B: Individual PostgreSQL variables (requires DB_ENGINE=postgres)
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# POSTGRES_DB=astroledger
# POSTGRES_USER=astroledger_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Connection pooling (seconds to keep idle connections alive; 0 = close after each request)
# CONN_MAX_AGE=600

# PostgreSQL SSL mode (leave empty for local dev; use 'require' or 'verify-full' for cloud)
# POSTGRES_SSL_MODE=require

# --- Authentication ---
# JWT_ACCESS_LIFETIME_MINUTES=60
# JWT_REFRESH_LIFETIME_DAYS=14

# --- CORS ---
# Comma-separated list of allowed origins (required when DEBUG=False)
# CORS_ALLOWED_ORIGINS=https://astroledger.example.com,https://app.astroledger.com

# --- Real-Time Sync & Channels (Redis) ---
# For local development with InMemoryChannelLayer, leave unset.
# In production, specify Redis connection string:
# REDIS_URL=redis://localhost:6379/0

# --- Throttling & Rate Limiting ---
# THROTTLE_RATE_AUTH=10/minute
# THROTTLE_RATE_ANON=100/day
# THROTTLE_RATE_USER=1000/day

# --- Security ---
# Set to False if running behind a reverse proxy that handles SSL termination
# SECURE_SSL_REDIRECT=True
